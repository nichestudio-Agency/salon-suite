rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isStaffOf(salonId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.salonId == salonId
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.ruolo in ['owner', 'staff'];
    }
    function isSuperAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.ruolo == 'superadmin';
    }

    match /salons/{salonId}/branding/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSuperAdmin();
    }

    match /salons/{salonId}/products/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOf(salonId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaffOf(salonId);
    }

    match /salons/{salonId}/services/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOf(salonId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaffOf(salonId);
    }

    match /salons/{salonId}/operators/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isStaffOf(salonId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isStaffOf(salonId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

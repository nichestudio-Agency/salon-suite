rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isStaffOf(salonId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().salonId == salonId
        && userData().ruolo in ['owner', 'staff'];
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.ruolo == 'cliente'
        && request.resource.data.keys().hasOnly(['nome','email','sesso','dataNascita','ruolo','salonId','fcmTokens']);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome','email','sesso','dataNascita','fcmTokens']);
      allow delete: if false;
    }

    match /salons/{salonId} {
      // Il documento identità del tenant è pubblico e viene risolto dal dominio.
      // La lista completa dei saloni non è mai esposta al client white-label.
      allow get: if true;
      allow list: if false;
      allow write: if isStaffOf(salonId);

      match /operators/{operatorId} {
        allow read: if isSignedIn();
        allow write: if isStaffOf(salonId);
      }

      match /services/{serviceId} {
        allow read: if isSignedIn();
        allow write: if isStaffOf(salonId);
      }

      match /bookings/{bookingId} {
        allow read: if isSignedIn()
          && (resource.data.clientId == request.auth.uid || isStaffOf(salonId));
        // Le creazioni passano dalla Cloud Function transazionale anti-concorrenza.
        allow create: if false;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato'])
          && ((isStaffOf(salonId)
               && ((resource.data.stato == 'in_attesa'
                    && request.resource.data.stato in ['confermata', 'rifiutata', 'annullata'])
                   || (resource.data.stato == 'confermata'
                       && request.resource.data.stato == 'annullata')))
              || (isSignedIn()
              && resource.data.clientId == request.auth.uid
              && resource.data.stato in ['in_attesa', 'confermata']
              && request.resource.data.stato == 'annullata'
             ));
        allow delete: if false;
      }

      match /products/{productId} {
        allow read: if isSignedIn();
        allow write: if isStaffOf(salonId);
      }

      match /orders/{orderId} {
        allow read: if isSignedIn()
          && (resource.data.clientId == request.auth.uid || isStaffOf(salonId));
        // Le creazioni passano dalla Cloud Function createOrder.
        allow create: if false;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato'])
          && ((isStaffOf(salonId)
               && ((resource.data.stato == 'in_attesa'
                    && request.resource.data.stato in ['pronto', 'annullato'])
                   || (resource.data.stato == 'pronto'
                       && request.resource.data.stato in ['ritirato', 'annullato'])))
              || (isSignedIn()
                  && resource.data.clientId == request.auth.uid
                  && resource.data.stato == 'in_attesa'
                  && request.resource.data.stato == 'annullato'));
        allow delete: if false;
      }

      match /coupons/{couponId} {
        allow read, write: if isStaffOf(salonId);
      }

      match /campaigns/{campaignId} {
        allow read: if isStaffOf(salonId);
        allow write: if false;
      }

      match /couponRedemptions/{redemptionId} {
        allow read: if isStaffOf(salonId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isSignedIn()
          && (resource.data.clientId == request.auth.uid || isStaffOf(salonId));
        allow write: if false;
      }
    }
  }
}
